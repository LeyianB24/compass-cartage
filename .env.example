# ==============================================================================
# COMPASS CARTAGE — ENVIRONMENT VARIABLE TEMPLATE (.env.example)
# ==============================================================================

# 1. DATABASE & PERSISTENCE (Neon Serverless PostgreSQL)
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require
DIRECT_URL=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require

# 2. ADMIN AUTHENTICATION & SECURITY
ADMIN_PASSWORD=your_secure_admin_password

# 3. EMAIL DISPATCH & NOTIFICATIONS (Resend)
RESEND_API_KEY=re_your_resend_api_key
CONTACT_EMAIL=your_team@compasscartage.ca
SENDER_EMAIL=Compass Cartage <onboarding@resend.dev>

# 4. CLOUD FILE STORAGE (Vercel Blob)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_token_here

# 5. PUBLIC CONFIGURATION
NEXT_PUBLIC_SITE_URL=https://compass-cartage.vercel.app
NEXT_PUBLIC_COMPANY_NAME="Compass Cartage"
NEXT_PUBLIC_COMPANY_PHONE="(780) 900-3490"
