// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum RequestStatus {
  NEW
  CONTACTED
  QUOTED
  BOOKED
  COMPLETED
  DECLINED
}

enum MoveType {
  LOCAL
  LONG_DISTANCE_ALBERTA
  OUT_OF_PROVINCE
}

model QuoteRequest {
  id             String        @id @default(cuid())
  name           String
  phone          String
  email          String
  pickupAddress  String
  dropoffAddress String
  moveDate       String?
  moveSize       String?
  distanceKm     Float?
  distanceFee    Float?
  pricingTier    String?
  estimatedPrice Float?
  notes          String?
  photoUrls      String[]      @default([])
  status         RequestStatus @default(NEW)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  bookedSlot     BookedSlot?

  @@index([status])
  @@index([createdAt])
}

model BookedSlot {
  id             String        @id @default(cuid())
  date           DateTime
  moveType       MoveType
  quoteRequestId String?       @unique
  quoteRequest   QuoteRequest? @relation(fields: [quoteRequestId], references: [id])
  createdAt      DateTime      @default(now())

  @@index([date])
  @@index([moveType])
}

model DistancePricingConfig {
  id               String   @id @default("default")
  includedKm       Float    @default(30.0)
  perKmRate        Float    @default(2.50)
  intercityFlatFee Float    @default(120.0)
  updatedAt        DateTime @updatedAt
}

model PricingTier {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String
  multiplier  Float    @default(1.0)
  baseFee     Float    @default(0.0)
  features    String[] @default([])
  isDefault   Boolean  @default(false)
  isActive    Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

